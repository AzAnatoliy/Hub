# Media Hub Environment Configuration
# Скопируйте этот файл в .env и заполните своими данными:
# cp .env.example .env

# ============================================================================
# Пользователь и группы
# ============================================================================
PUID=1000
PGID=1000

# ============================================================================
# Директории
# ============================================================================
# Основная директория для данных контейнеров
DATA_DIR=./data

# Директория с медиа-файлами
MEDIA_DIR=/home/media

# Директория с конфигурациями
CONFIG_DIR=./configs

# ============================================================================
# Сеть
# ============================================================================
# IP-адрес LAN для привязки портов (127.0.0.1 для локального доступа)
# Используйте 0.0.0.0 для доступа из всей сети (НЕБЕЗОПАСНО без firewall)
LAN_IP=127.0.0.1

# ============================================================================
# Mihomo Proxy
# ============================================================================
# Прокси-сервер (замените на свои данные)
MIHOMO_SERVER=your-server.com
MIHOMO_PORT=443
MIHOMO_UUID=your-uuid-here
MIHOMO_PATH=/path

# ============================================================================
# Home Assistant
# ============================================================================
# Long-Lived Access Token (создайте в HA: Профиль → Long-Lived Access Tokens)
HA_TOKEN=your_long_lived_access_token_here

# ============================================================================
# IP-камеры (Go2RTC)
# ============================================================================
# RTSP ссылки на камеры (замените на свои)
CAM1_RTSP=rtsp://username:password@192.168.1.101:554/stream1
CAM2_RTSP=rtsp://username:password@192.168.1.102:554/stream1

# ============================================================================
# USB ЦАП
# ============================================================================
# Номер карты из aplay -l (может меняться после перезагрузки)
# Рекомендуется использовать имя устройства вместо номера
ALSA_CARD=1

# ============================================================================
# Hermes AI
# ============================================================================
# Модель Whisper: tiny, base, small, medium, large
WHISPER_MODEL=base
WHISPER_DEVICE=cpu

# ============================================================================
# Безопасность
# ============================================================================
# НЕ КОММИТЬТЕ .env В GIT!
# Добавьте .env в .gitignore (уже сделано)
