# Go2RTC конфигурация
# Документация: https://github.com/AlexxIT/go2rtc
#
# ⚠️  ВАЖНО: Этот файл НЕ коммитится в git (содержит пароли)!
# Используйте .env для хранения паролей камер.

api:
  listen: ":1984"

streams:
  # Камера 1 - Гараж (вход)
  # Формат: rtsp://username:password@IP:port/path
  cam1:
    - rtsp://192.168.1.101:554/stream1
  
  # Камера 2 - Гараж (внутрь)
  cam2:
    - rtsp://192.168.1.102:554/stream1

# Замените IP-адреса, логины и пароли на данные ваших камер
# Для безопасности используйте переменные окружения или .env

rtsp:
  listen: ":8554"

webrtc:
  listen: ":8555"

ffmpeg:
  bin: /usr/bin/ffmpeg
