# Mihomo конфигурация для России
# Документация: https://wiki.metacubex.one/
#
# ⚠️  ВАЖНО: Этот файл НЕ коммитится в git (содержит пароли)!
# Скопируйте этот пример и заполните своими данными:
# cp configs/mihomo/config.yaml.example /etc/mihomo/config.yaml
# sudo nano /etc/mihomo/config.yaml

mixed-port: 7890
allow-lan: true
bind-address: '*'
mode: rule
log-level: info
ipv6: false
unified-delay: true
geodata-mode: true
tcp-concurrent: true

# ⚠️  ОБЯЗАТЕЛЬНО настройте аутентификацию!
authentication:
  - "user:password"  # Замените на свои данные

# Панель управления (привязана к localhost)
external-controller: 127.0.0.1:9090
secret: "your-dashboard-secret"  # Замените на свой пароль

# DNS настройки (Россия + международные)
dns:
  enable: true
  listen: 0.0.0.0:1053
  ipv6: false
  enhanced-mode: fake-ip
  fake-ip-range: 198.18.0.1/16
  default-nameserver:
    - 1.1.1.1
    - 8.8.8.8
  nameserver:
    - https://dns.google/dns-query
    - https://cloudflare-dns.com/dns-query
  fallback:
    - https://dns.google/dns-query
    - https://cloudflare-dns.com/dns-query
  fallback-filter:
    geoip: true
    geoip-code: RU

# ⚠️  Замените на свои данные прокси
proxies:
  - name: "proxy-1"
    type: vless
    server: your-server.com
    port: 443
    uuid: your-uuid-here
    network: ws
    tls: true

proxy-groups:
  - name: "Proxy"
    type: select
    proxies:
      - proxy-1
      - DIRECT

rules:
  - GEOIP,private,DIRECT,no-resolve
  - GEOSITE,category-ru,DIRECT
  - GEOSITE,telegram,Proxy
  - GEOSITE,youtube,Proxy
  - GEOSITE,google,Proxy
  - GEOSITE,category-ads-all,REJECT
  - GEOIP,RU,DIRECT
  - MATCH,Proxy
